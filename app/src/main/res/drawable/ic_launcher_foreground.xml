<?xml version="1.0" encoding="utf-8"?>
<!--
Updated <vector> drawable for the Volume Mixer app icon.
Vertical stripes removed, centered, and no explicit background.
--><vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
    The outer group handles scaling and translation.
    To center the content after removing vertical stripes,
    I'll adjust the translateX to effectively shift the content to the left
    since the content itself is narrower now.
    --><group
    android:translateX="54"
    android:translateY="54">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6">

        <!--
        Removed the explicit light gray square background path.
        The icon will now be transparent where no other paths are drawn.
        --><!--
            HORIZONTAL SLIDER 1 (Top)
            Position: Y = -20
            The tracks are now centered around X=0.
            The tracks now span from X=-25 to X=25 (50 units wide).
            Knob 1 (Rounded Square - positioned at 75% volume, X=12.5)
            Track is centered -25, 25
            --><path
        android:fillColor="#FFFFFFFF"
        android:pathData="M-25,-22 H25 V-18 H-25 Z" />
        <path
            android:fillColor="#2196F3"
            android:pathData="M12.5,-24.5 h10 a2.5,2.5 0,0 1 2.5,2.5 v5 a2.5,2.5 0,0 1 -2.5,2.5 h-10 a2.5,2.5 0,0 1 -2.5,-2.5 v-5 a2.5,2.5 0,0 1 2.5,-2.5 Z" />

        <!--
        HORIZONTAL SLIDER 2 (Middle)
        Position: Y = 0
        Knob 2 (Rounded Square - positioned at 50% volume, X=0)
        --><path
        android:fillColor="#FFFFFFFF"
        android:pathData="M-25,-2 H25 V2 H-25 Z" />
        <path
            android:fillColor="#4CAF50"
            android:pathData="M0,-4.5 h10 a2.5,2.5 0,0 1 2.5,2.5 v5 a2.5,2.5 0,0 1 -2.5,2.5 h-10 a2.5,2.5 0,0 1 -2.5,-2.5 v-5 a2.5,2.5 0,0 1 2.5,-2.5 Z" />

        <!--
        HORIZONTAL SLIDER 3 (Bottom)
        Position: Y = 20
        Knob 3 (Rounded Square - positioned at 25% volume, X=-12.5)
        --><path
        android:fillColor="#FFFFFFFF"
        android:pathData="M-25,18 H25 V22 H-25 Z" />
        <path
            android:fillColor="#FF9800"
            android:pathData="M-12.5,15.5 h10 a2.5,2.5 0,0 1 2.5,2.5 v5 a2.5,2.5 0,0 1 -2.5,2.5 h-10 a2.5,2.5 0,0 1 -2.5,-2.5 v-5 a2.5,2.5 0,0 1 2.5,-2.5 Z" />

        <!-- Removed Left Labels (Input) --><!-- Removed Right Output --></group>
</group>
</vector>